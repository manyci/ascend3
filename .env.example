# GEMINI_API_KEY: Required for server-side Barrett AI mentor calls via @google/genai.
# Configure this in Settings > Secrets. Never place real keys in client JS or this file.
GEMINI_API_KEY=

# Optional Barrett AI server configuration (changeable without modifying client code):
BARRETT_MODEL=gemini-3.5-flash-lite
BARRETT_ANALYZE_MODEL=gemini-3.5-flash-lite
BARRETT_THINKING_LEVEL=LOW
# Safe defaults for Vercel Hobby 10s function limit (for Node/Cloud Run 30s hosts, 25000 / 10500 / 13500 may be used):
BARRETT_TIMEOUT_MS=8500
BARRETT_PRIMARY_FALLBACK_TIMEOUT_MS=4500
BARRETT_RETRY_DELAYS_MS=250,500
BARRETT_DAILY_TOTAL_CAP=250

# Optional Cloudflare Workers AI fallback (Barrett text-only chat, opt-in user consent only):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BARRETT_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
BARRETT_CLOUDFLARE_TIMEOUT_MS=3500
